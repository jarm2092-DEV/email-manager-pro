# Copy these into Vercel → Project → Settings → Environment Variables.
# Nothing here belongs in the repo with real values: .env is gitignored.

# Power Automate HTTP trigger URLs, complete with their ?sig=... signature.
# These are the secrets. They stay server-side and never reach the browser.
FLOW_READ_URL=
FLOW_WRITE_URL=

# Supabase project. The anon key is public by design — it is served to the
# taskpane by /api/config so the login form can talk to Supabase.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
